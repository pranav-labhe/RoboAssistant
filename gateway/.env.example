# ============================================================================
# ESP32-S3 Voice Robot Gateway Configuration (.env)
# Copy this file to `.env` inside `c:\Robo\gateway\`
# ============================================================================

# Token required in `Authorization: Bearer <token>` from the ESP32-S3
GATEWAY_BEARER_TOKEN=dev-robot-token-change-me

# Mix-and-match providers:
#   STT_PROVIDER: gemini | openai | mock
#   LLM_PROVIDER: chit   | gemini | openai | mock
#   TTS_PROVIDER: gemini | openai | mock
STT_PROVIDER=gemini
LLM_PROVIDER=gemini
TTS_PROVIDER=gemini

# --- 1. Chit ("Pranav's Atmini Brain" — C:\Python\Chit) ---
# Use https://api.chitt.online when running gateway on your Dell laptop,
# or http://127.0.0.1:8000 when running gateway on the EC2 t4g.small box.
CHIT_BASE_URL=https://api.chitt.online
CHIT_API_KEY=replace-with-your-chit-api-key
CHIT_THINK=false

# --- 2. Google Gemini API (Google AI Studio key) ---
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck

# --- 3. OpenAI / OpenAI-Compatible Server (/v1/...) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
