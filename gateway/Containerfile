FROM python:3.13-slim

WORKDIR /app

# Create non-root user for safety
RUN useradd -m -u 10001 gatewayuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py adapters.py ./

USER gatewayuser
EXPOSE 8002

# Single-worker async uvicorn (minimal RAM footprint alongside Chit on 2 GiB t4g.small)
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1", "--no-access-log"]
