#pragma once

// ============================================================================
// Copy this file to `~/.robo_secrets/robot_secrets.h` (recommended, outside repo)
// or `include/secrets.h` (git-ignored fallback) and fill in your credentials.
//
// Dual Operating Modes:
//   - Mode A (Direct On-Chip Mode, Default): The ESP32 connects directly to
//     Google Gemini over verified TLS. Set DIRECT_GEMINI_API_KEY below.
//   - Mode B (Voice Gateway Mode): The ESP32 talks to your local/cloud FastAPI
//     Voice Gateway. Third-party AI keys live in `~/.robo_secrets/gateway.env`.
// ============================================================================

#define WIFI_SSID             "YOUR_2.4GHZ_WIFI_SSID"
#define WIFI_PASSWORD         "YOUR_WIFI_PASSWORD"

// Your Gateway Server (used when mode == "gateway" and in Gates 6-7)
#define GATEWAY_BASE_URL      "https://your-domain.example.com"
#define GATEWAY_BEARER_TOKEN  "REPLACE_WITH_RANDOM_32_BYTE_GATEWAY_TOKEN"

// Optional Direct On-Chip Mode defaults (can also be updated live via POST http://<robot-ip>/config)
#define ROBOT_DEFAULT_MODE    "direct"   // "direct" (no Gateway hop) or "gateway"
#define DIRECT_GEMINI_API_KEY ""
#define DIRECT_CHIT_API_KEY   ""
